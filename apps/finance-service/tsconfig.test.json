{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "paths": {
      "@household/common": ["libs/common/src"],
      "@household/common/*": ["libs/common/src/*"],
      "@household/contracts": ["libs/contracts/src"],
      "@household/contracts/*": ["libs/contracts/src/*"],
      "@household/database": ["libs/database/src"],
      "@household/database/*": ["libs/database/src/*"],
      "@household/kafka": ["libs/kafka/src"],
      "@household/kafka/*": ["libs/kafka/src/*"],
      "@household/audit": ["libs/audit/src"],
      "@household/audit/*": ["libs/audit/src/*"],
      "@household/testing": ["libs/testing/src"],
      "@household/testing/*": ["libs/testing/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "../../libs/testing/src/**/*"]
}
