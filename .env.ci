# ─────────────────────────────────────────────────────────────────────────
# CI / local-scenario stack only — DO NOT use for a real deployment.
#
# Every value below is a self-describing fake, deliberately committed (unlike
# `.env`, which is gitignored). Copied to `.env` before `docker compose up`
# so `docker compose` variable substitution AND every service's `env_file:
# .env` both see it. Consumed by the pre-commit API scenario check (#208)
# and the CI api-scenarios workflow (#209).
#
# One shared file — rather than generating it inline per-workflow — matters
# for GATEWAY_SIGNING_SECRET specifically: internal services silently bypass
# trust-header verification when it's unset in non-production, so the only
# actually-broken state is a *partial* set across services. One file makes
# that impossible.
# ─────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
API_PORT=3000

# PostgreSQL — matches docker-compose.yml's postgres service defaults.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=household
POSTGRES_PASSWORD=household_secret
POSTGRES_DB=household

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — obviously-fake, 48 chars, not a real secret. NODE_ENV=development
# means requireStrongJwtSecret() only checks presence, but keeping it long
# and non-placeholder here so this file can't accidentally validate as a
# production-strength secret if ever misused as one.
JWT_SECRET=ci-only-not-a-real-secret-do-not-use-in-prod-000
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Auth cookies — matches docker-compose.yml's auth-service override
# (host-mode runs need it set here too since env_file loses to compose's
# own `environment:` block, not the other way around).
AUTH_COOKIE_SECURE=false

# CORS — gateway/realtime-gateway both refuse to boot if empty.
CORS_ORIGIN=http://localhost:5173
WS_CORS_ORIGINS=http://localhost:5173

# Shared HMAC secret for gateway trust headers (X-User-Id etc.) — see the
# file header above for why this must be identical across every service.
GATEWAY_SIGNING_SECRET=ci-only-not-a-real-secret

# integration-service — encrypts bank connection tokens (e.g. Monobank) at
# rest. Obviously-fake, same "long and non-placeholder" reasoning as
# JWT_SECRET above.
TOKEN_ENCRYPTION_KEY=ci-only-not-a-real-secret-do-not-use-in-prod-000

# Auth Service — OAuth is out of scope for the automated scenario collection
# (#192 decision: register/verify/OAuth stay manual), so these are unused
# placeholders, kept only so the service boots without a missing-key warning.
AUTH_SERVICE_PORT=3001
GOOGLE_CLIENT_ID=ci-unused-google-client-id
APPLE_CLIENT_ID=ci-unused-apple-client-id

# E2E scenario users (#204) — scripts/seed-e2e-user.js seeds these two
# pre-verified accounts so the Postman/Newman collection can start at
# POST /auth/login. Fixed, non-secret values — this stack is
# ephemeral/local-only and these users hold no real data.
E2E_EMAIL=e2e-owner@household.local
E2E_INVITEE_EMAIL=e2e-invitee@household.local
E2E_PASSWORD=E2eScenario!Passw0rd

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_SIGNING_KEY=
KAFKA_SIGNING_KEY_PREV=

# Service URLs (host-mode values; docker-compose.yml overrides these to
# in-network hostnames per service via its own `environment:` block).
AUTH_SERVICE_URL=http://localhost:3001
HOUSEHOLD_SERVICE_URL=http://localhost:3002
FINANCE_SERVICE_URL=http://localhost:3003
SHOPPING_SERVICE_URL=http://localhost:3004
INTEGRATION_SERVICE_URL=http://localhost:3005

# Rate limiting — bumped well above the 100/60s default. The gateway's
# global throttler would otherwise trip partway through a single ~45-request
# Postman collection run, let alone the repeated runs pre-commit does.
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# /auth/refresh's specific per-IP limit (default 5/60s, see .env.example)
# bumped for the same reason as THROTTLE_LIMIT above, plus #249: this stack
# runs behind Docker's bridge networking, so every request from the host —
# every pre-commit run, every repeated local `docker compose up` session —
# shares one apparent IP.
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_RATE_WINDOW_SECONDS=60

# Realtime Gateway (Socket.IO)
REALTIME_GATEWAY_PORT=3010
