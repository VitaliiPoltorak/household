# Application
NODE_ENV=development
API_PORT=3000

# Network binding for internal services (auth, household, finance, shopping).
# Defaults to 127.0.0.1 so services are not reachable from the LAN. Override
# to 0.0.0.0 for containerized deployments where the gateway lives in a
# different container on the same network.
# LISTEN_HOST=127.0.0.1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=household
POSTGRES_PASSWORD=household_secret
POSTGRES_DB=household

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# REQUIRED. Generate with: openssl rand -base64 48
# In production the service refuses to start if this is empty, matches a known
# placeholder ("change-me", "secret", etc.), or is shorter than 32 chars.
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# CORS
# REQUIRED for api-gateway. Comma-separated list of allowed browser origins for
# the REST API. Example (dev): CORS_ORIGIN=http://localhost:5173
# In production, api-gateway refuses to start if this is empty.
CORS_ORIGIN=http://localhost:5173
# REQUIRED for realtime-gateway. Comma-separated list of allowed origins for
# the Socket.IO handshake. Set to the web app origin.
WS_CORS_ORIGINS=http://localhost:5173

# Shared secret used by api-gateway (and realtime-gateway) to sign trust
# headers (X-User-Id, X-Household-Id, X-User-Email). Internal services
# verify this signature before honoring the headers. REQUIRED in
# production — services refuse to start if NODE_ENV=production and this
# is empty. In dev/test it may be omitted, in which case verification is
# skipped with a warning.
GATEWAY_SIGNING_SECRET=dev-only-change-me

# Auth Service
AUTH_SERVICE_PORT=3001
GOOGLE_CLIENT_ID=your-google-client-id
APPLE_CLIENT_ID=your-apple-client-id

# Kafka
KAFKA_BROKERS=localhost:9092

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
HOUSEHOLD_SERVICE_URL=http://localhost:3002
FINANCE_SERVICE_URL=http://localhost:3003
SHOPPING_SERVICE_URL=http://localhost:3004

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Realtime Gateway (Socket.IO)
REALTIME_GATEWAY_PORT=3010
