# Application
NODE_ENV=development
API_PORT=3000

# Network binding for internal services (auth, household, finance, shopping).
# Defaults to 127.0.0.1 so services are not reachable from the LAN. Override
# to 0.0.0.0 for containerized deployments where the gateway lives in a
# different container on the same network.
# LISTEN_HOST=127.0.0.1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=household
POSTGRES_PASSWORD=household_secret
POSTGRES_DB=household

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# REQUIRED. Generate with: openssl rand -base64 48
# In production the service refuses to start if this is empty, matches a known
# placeholder ("change-me", "secret", etc.), or is shorter than 32 chars.
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Auth cookies (#60/#61) — refresh token is stored in an HttpOnly cookie
# instead of localStorage. Set to `false` ONLY for local http:// dev on
# non-localhost hosts. In prod this MUST be true (SameSite=None requires
# Secure). localhost is exempt from the Secure requirement.
AUTH_COOKIE_SECURE=true

# CORS
# REQUIRED for api-gateway. Comma-separated list of allowed browser origins for
# the REST API. Example (dev): CORS_ORIGIN=http://localhost:5173
# In production, api-gateway refuses to start if this is empty.
CORS_ORIGIN=http://localhost:5173
# REQUIRED for realtime-gateway. Comma-separated list of allowed origins for
# the Socket.IO handshake. Set to the web app origin.
WS_CORS_ORIGINS=http://localhost:5173

# Shared secret used by api-gateway (and realtime-gateway) to sign trust
# headers (X-User-Id, X-Household-Id, X-User-Email). Internal services
# verify this signature before honoring the headers. REQUIRED in
# production — services refuse to start if NODE_ENV=production and this
# is empty. In dev/test it may be omitted, in which case verification is
# skipped with a warning.
GATEWAY_SIGNING_SECRET=dev-only-change-me

# Auth Service
AUTH_SERVICE_PORT=3001
GOOGLE_CLIENT_ID=your-google-client-id
APPLE_CLIENT_ID=your-apple-client-id

# Dev-only: logs plaintext verification codes / unlock tokens (masked email)
# at INFO so a developer without notification-service (#30) can complete the
# register/verify or account-unlock flow manually. Default false. The service
# refuses to start if this is true while NODE_ENV=production (#212).
AUTH_DEV_LOG_SECRETS=true

# E2E scenario users (#204) — consumed by scripts/seed-e2e-user.js to seed
# two pre-verified email/password accounts (an owner + an invitee, needed
# for the household-invite flow) so the Postman/Newman scenario collection
# can start at POST /auth/login instead of a manual register+verify flow.
# Only meaningful when the seed script is run — harmless if unset elsewhere.
# E2E_EMAIL=e2e-owner@household.local
# E2E_INVITEE_EMAIL=e2e-invitee@household.local
# E2E_PASSWORD=E2eScenario!Passw0rd

# Kafka
KAFKA_BROKERS=localhost:9092
# Optional HMAC-SHA256 key used to authenticate messages between services (#63).
# Leave empty in dev — producers omit the signature header and consumers accept
# unsigned messages. In staging/prod set a shared secret. During rotation, keep
# the old value in KAFKA_SIGNING_KEY_PREV while the new one propagates.
KAFKA_SIGNING_KEY=
KAFKA_SIGNING_KEY_PREV=

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
HOUSEHOLD_SERVICE_URL=http://localhost:3002
FINANCE_SERVICE_URL=http://localhost:3003
SHOPPING_SERVICE_URL=http://localhost:3004
INTEGRATION_SERVICE_URL=http://localhost:3005

# Gateway proxy routes — optional overrides. If unset, the gateway ships
# with a default table in apps/api-gateway/src/proxy/routes.default.json.
# PROXY_ROUTES_JSON wins over PROXY_ROUTES_PATH, which wins over the default.
# PROXY_ROUTES_JSON=[{"prefix":"/api/v1/foo","envKey":"FOO_URL","defaultUrl":"http://foo:3000","rewrites":{"^":"/foo"}}]
# PROXY_ROUTES_PATH=/etc/household/proxy-routes.json

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# /auth/refresh is called once per page load, unlike the other per-endpoint
# auth limits (login/register/OAuth), which only fire on deliberate user
# actions. Behind Docker's default bridge networking, every request from the
# host machine shares one apparent source IP (the bridge gateway) regardless
# of tab/reload count, so the default 5/60s is easy to trip with ordinary
# multi-tab local development (#249). Production is unaffected — a real
# deploy behind a reverse proxy sees each client's real IP, so leave these
# unset there (defaults to the strict 5/60s). Raise only for local dev, e.g.:
# AUTH_REFRESH_RATE_LIMIT=30
# AUTH_REFRESH_RATE_WINDOW_SECONDS=60

# Realtime Gateway (Socket.IO)
REALTIME_GATEWAY_PORT=3010

# Integration Service (Monobank)
INTEGRATION_SERVICE_PORT=3005
# Base URL of the Monobank Personal API. Override only for testing against a
# stub/mock server.
MONOBANK_API_BASE_URL=https://api.monobank.ua
# REQUIRED. Encrypts bank connection tokens (e.g. Monobank) at rest
# (AES-256-GCM). Generate with: openssl rand -base64 48
# In production the service refuses to start if this is empty, matches a
# known placeholder, or is shorter than 32 chars — same rule as JWT_SECRET.
TOKEN_ENCRYPTION_KEY=dev-only-change-me-please-32-chars-min
# Optional, same rotation convention as KAFKA_SIGNING_KEY_PREV. To rotate:
# 1) move the current TOKEN_ENCRYPTION_KEY value here, 2) set
# TOKEN_ENCRYPTION_KEY to a newly generated key. Existing bank_connections
# rows still decrypt via this fallback; new connects always use the new
# primary key. Once every row has been re-encrypted under the new key
# (separate migration script, not yet built), this can be unset again.
TOKEN_ENCRYPTION_KEY_PREV=
