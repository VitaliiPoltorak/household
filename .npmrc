# #357: apps/mobile (React 19, via Expo/react-native) and apps/web (React 18)
# need different @types/react majors side by side. pnpm's default hoist
# pattern ('*') places exactly one resolved copy of every package into a
# shared node_modules/.pnpm/node_modules/ bucket, used as a fallback by
# tools (tsc included) that don't do pnpm's strict per-package resolution —
# e.g. resolving the ambient `react` types referenced from react-router-dom's
# own .d.ts, which has no direct dependency on @types/react of its own.
# With two versions in the store, that bucket becomes ambiguous and picked
# the wrong (mobile's) one for apps/web's build. Excluding @types/react(-dom)
# from the shared bucket forces every consumer back to its own package's
# properly peer-isolated resolution instead.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
