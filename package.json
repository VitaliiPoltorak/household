{
  "name": "household",
  "version": "0.0.1",
  "private": true,
  "description": "Household — family finance & shopping management",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "web": "pnpm --filter @household/web dev",
    "gateway": "pnpm --filter @household/api-gateway dev",
    "auth": "pnpm --filter @household/auth-service dev",
    "household": "pnpm --filter @household/household-service dev",
    "finance": "pnpm --filter @household/finance-service dev",
    "shopping": "pnpm --filter @household/shopping-service dev",
    "integration": "pnpm --filter @household/integration-service dev",
    "realtime": "pnpm --filter @household/realtime-gateway dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:postman": "newman run docs/postman/household.postman_collection.json -e docs/postman/household.postman_environment.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "hooks:enable": "git config core.hooksPath .githooks && echo '✔ git core.hooksPath = .githooks — post-merge/post-checkout will now auto-rebuild running Docker services when their sources change.'",
    "hooks:disable": "git config --unset core.hooksPath && echo '✔ git core.hooksPath unset — hooks disabled.'"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jest": "^29.7.0",
    "kafkajs": "^2.2.4",
    "newman": "^6.2.2",
    "pg": "^8.12.0",
    "prettier": "^3.3.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node-dev": "^2.0.0",
    "turbo": "^2.1.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  }
}
