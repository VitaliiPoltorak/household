#!/usr/bin/env bash
# Runs unit tests, then the automated API scenario gate (#192/#208), before
# every commit.
#
# Unit tests are fast (no Docker). The API scenario gate needs Docker and
# always runs — the maintainer decision is that this gate is not gated on
# "stack already running"; scripts/api-scenarios.sh brings the stack up
# itself if needed, rebuilding only what changed. Set SKIP_API_SCENARIOS=1
# to bypass just that step, or use `git commit --no-verify` to skip
# everything (both discouraged).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "pre-commit: running pnpm test:unit …"
pnpm test:unit

echo "pre-commit: running API scenario gate …"
"$REPO_ROOT/scripts/api-scenarios.sh"
