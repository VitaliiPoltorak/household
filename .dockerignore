# Everything that shouldn't end up in the build context — keeps `docker
# compose build` fast and images small. Aligns with CI's expectations of
# a clean checkout.
**/node_modules
**/dist
**/build
**/coverage
**/.turbo
**/*.tsbuildinfo

# Local secrets — services should get env via compose env vars, not baked in
.env
.env.local
.env.*.local

# Tests / dev tooling that runtime doesn't need
**/test
**/*.spec.ts
**/*.test.ts
**/jest.*.config.js
**/vitest.config.ts

# IDE / OS / tooling clutter
.idea
.vscode
.DS_Store
.claude

# Git + CI (nothing runtime cares about)
.git
.gitignore
.github

# Web app — built on host, not in these images
apps/web

# Mobile app (Expo/React Native, #357) — never built into a backend image;
# its dependency tree stays out via `pnpm deploy` in the runtime stage
# (#377), this just keeps its source out of the build context too.
apps/mobile

# Docker + infra config
Dockerfile
.dockerignore
docker-compose.yml
infra
docs

# NOTE: root scripts/ is intentionally NOT ignored — scripts/seed-e2e-user.js
# (#204) runs *inside* the built service images via `docker compose exec`,
# so it must ship with them. Don't add scripts/ here without checking that
# doesn't break the API scenario seeding flow.
